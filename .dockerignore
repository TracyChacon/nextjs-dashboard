# 1. Dependency and Build Artifacts (Most Important for Size/Speed)
# Since you run 'pnpm install' inside the container, don't copy the host's large node_modules.
node_modules
# Exclude the Next.js build output directory
.next

# 2. Sensitive Files (Security Critical)
# NEVER include environment files containing API keys, database credentials, etc.
.env
.env.*
.db.env

# 3. Version Control (Clutter/Security)
# The Git repository history is not needed for the app to run.
.git
.gitignore

# 4. Logs and Cache
# These files are generated during development/runtime and should not be included.
npm-debug.log
pnpm-debug.log*
*.log
tmp/
.cache/

# 5. IDE/Editor Specific Files (Clutter)
# Files generated by popular code editors and OS files.
.vscode
.idea
.DS_Store